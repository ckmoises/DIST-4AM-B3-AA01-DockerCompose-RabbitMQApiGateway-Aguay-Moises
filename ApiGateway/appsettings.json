{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "categoriasRoute": {
        "ClusterId": "categoriasCluster",
        "Match": {
          "Path": "/api/categorias/{**catch-all}"
        }
      },
      "vehiculosRoute": {
        "ClusterId": "vehiculosCluster",
        "Match": {
          "Path": "/api/vehiculos/{**catch-all}"
        }
      },
      "swaggerCategoriasRoute": {
        "ClusterId": "categoriasCluster",
        "Match": {
          "Path": "/swagger/categoria/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/{**catch-all}" }
        ]
      },
      "swaggerVehiculosRoute": {
        "ClusterId": "vehiculosCluster",
        "Match": {
          "Path": "/swagger/vehiculo/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "categoriasCluster": {
        "Destinations": {
          "categoriasDestination": {
            "Address": "http://localhost:5000"
          }
        }
      },
      "vehiculosCluster": {
        "Destinations": {
          "vehiculosDestination": {
            "Address": "http://localhost:5001"
          }
        }
      }
    }
  }
}
